# Orders service image (confusedcrib/insecure-api-orders), deployed by the
# `orders` section of insecure-chart. Build from this directory:
#   docker build -f Dockerfile.orders -t confusedcrib/insecure-api-orders .
FROM python:3.9-slim

ENV PYTHONUNBUFFERED=1 \
    PYTHONDONTWRITEBYTECODE=1

WORKDIR /app

COPY requirements.txt /app/
RUN pip install --no-cache-dir --upgrade pip \
    && pip install --no-cache-dir -r requirements.txt

# videogames.db ships with the image so startup does not try to create it in
# the read-only /app.
COPY main.py models.py database.py orders.py videogames.db /app/

RUN useradd --system --uid 10001 --no-create-home --shell /usr/sbin/nologin orders
USER 10001

# Same port as the load balancer target group (terraform/orders.tf).
EXPOSE 8080

CMD ["uvicorn", "main:app", "--host", "0.0.0.0", "--port", "8080"]
